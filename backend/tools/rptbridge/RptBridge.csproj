<Project Sdk="Microsoft.NET.Sdk">
  <!-- dotnet build -c Release -p:CrystalDllDir="<folder holding the CrystalDecisions DLLs>"
       The installed SAP Crystal runtime is 32-bit, so this is an x86 .NET Framework exe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>RptBridge</AssemblyName>
    <RootNamespace>RptBridge</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CrystalDllDir Condition="'$(CrystalDllDir)' == ''">$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL</CrystalDllDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Drawing" />
    <Reference Include="CrystalDecisions.CrystalReports.Engine">
      <HintPath>$(CrystalDllDir)\CrystalDecisions.CrystalReports.Engine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CrystalDecisions.Shared">
      <HintPath>$(CrystalDllDir)\CrystalDecisions.Shared.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
