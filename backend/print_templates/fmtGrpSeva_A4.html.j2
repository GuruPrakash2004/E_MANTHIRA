{% extends "_base.html.j2" %}
{% block body %}
  <div class="banner">ಗುಂಪು ಸೇವಾ ರಶೀದಿ &middot; GROUP SEVA RECEIPT</div>
  <table style="width:100%;margin-top:6px"><tr>
    <td>Receipt No: <b>{{ print_no or record_id }}</b></td>
    <td class="right">Date: <b>{{ doc_date }}</b></td>
  </tr></table>
  <div>Name: <b>{{ name or "-" }}</b>{% if mobile %} - Mobile: {{ mobile }}{% endif %}</div>
  <table style="width:100%;border-collapse:collapse;margin-top:8px">
    <tr><th style="width:6%">Sl</th><th>Sannidhi</th><th>Seva</th><th>Name</th><th>Gothra</th><th>Nakshatra</th><th>Rashi</th><th style="width:14%">Rate (Rs)</th></tr>
    {% for l in lines %}<tr><td class="c">{{ l.slno }}</td><td class="c">{{ l.sannidhi }}</td><td class="c">{{ l.seva }}</td><td class="c">{{ l.name }}</td><td class="c">{{ l.gothra }}</td><td class="c">{{ l.nakshatra }}</td><td class="c">{{ l.rashi }}</td><td class="c right">{{ l.rate }}</td></tr>{% endfor %}
    <tr><td class="c right bold" colspan="7">Total</td><td class="c right bold">{{ amount }}</td></tr>
  </table>
  <div style="margin-top:6px">Amount in words: <b>{{ amount_in_words }}</b></div>
  <table style="width:100%;margin-top:40px"><tr><td>Issued by: {{ issued_by }}</td><td class="right">Authorised signatory</td></tr></table>
{% endblock %}
