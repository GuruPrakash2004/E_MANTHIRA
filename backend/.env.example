# Copy to .env and fill in real values. Never commit .env itself.

APP_ENV=development
API_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173

# --- SQL Server: SAME database the legacy vTemple7.exe uses ---
DB_DRIVER_ODBC=
DB_SERVER=192.168.1.3
DB_PORT=58639
DB_NAME=vTmplSLV
DB_USER=sa
DB_PASSWORD=svt123
DB_TRUST_CERT=yes
# DB_ENGINE: pyodbc (needs ODBC Driver 18 installed) or pymssql (pure python, easier on macOS)
DB_ENGINE=pyodbc
AUDIT_DB_NAME=vTmplSLVAuditLog

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# Key used by the legacy svtCrypto (3DES-ECB, MD5-derived key) so MstUser.LoginPwd
# stays readable/writable while the old EXE and this app share the same DB.
LEGACY_CRYPTO_KEY=svt$$12@#

# --- Paths (legacy Rpts share) ---
RPT_PATH=./Rpts/
# RPT_FOLDER overrides RPT_PATH (the folder with the original Crystal .rpt files)
RPT_FOLDER=
ATTACHMENTS_PATH=../../vTempleSLV/Rpts/TrnDocFiles/

# --- Printing: the Crystal Reports bridge (see backend/tools/rptbridge/README.md) ---
# The app NEVER renders .rpt files itself and nothing imitates them: it always calls the bridge,
# which owns the real Crystal Reports runtime and opens the original .rpt files.
CRYSTAL_SERVICE_URL=http://localhost:8100
# Print bridge: URL (defaults to CRYSTAL_SERVICE_URL) and the shared key sent as X-Rpt-Bridge-Key
RPT_BRIDGE_URL=
RPT_BRIDGE_KEY=
# RPT_BRIDGE_AUTOSTART=0 stops the backend launching tools/rptbridge/bin/RptBridge.exe (an explicit RPT_BRIDGE_URL also stops it)
RPT_BRIDGE_AUTOSTART=1 
CRYSTAL_SERVICE_TIMEOUT_SECONDS=20

# --- Messaging (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_URL=
SMS_SENDER=
