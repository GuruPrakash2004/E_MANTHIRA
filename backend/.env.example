# Copy to .env and fill in real values. Never commit .env itself.

APP_ENV=development
API_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173

# --- SQL Server: SAME database the legacy vTemple7.exe uses ---
DB_DRIVER_ODBC=ODBC Driver 18 for SQL Server
DB_SERVER=127.0.0.1
DB_PORT=14333
DB_NAME=vTmplSLV
DB_USER=sa
DB_PASSWORD=change-me
DB_TRUST_CERT=yes
# DB_ENGINE: pyodbc (needs ODBC Driver 18 installed) or pymssql (pure python, easier on macOS)
DB_ENGINE=pymssql
AUDIT_DB_NAME=vTmplSLVAuditLog

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# Key used by the legacy svtCrypto (3DES-ECB, MD5-derived key) so MstUser.LoginPwd
# stays readable/writable while the old EXE and this app share the same DB.
LEGACY_CRYPTO_KEY=svt$$12@#

# --- Paths (legacy Rpts share) ---
RPT_PATH=./Rpts/
ATTACHMENTS_PATH=../../vTempleSLV/Rpts/TrnDocFiles/

# --- Printing: Crystal Reports print service (see backend/print_service/README.md) ---
# The app NEVER renders .rpt files itself. It always calls this external service,
# which owns the real Crystal Reports runtime (or, in dev, the mock bridge in print_service/).
CRYSTAL_SERVICE_URL=http://localhost:8100
CRYSTAL_SERVICE_TIMEOUT_SECONDS=20

# --- Messaging (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_URL=
SMS_SENDER=
